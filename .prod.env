# Configuration de production pour le déploiement sur VPS (music.julien-sabourin.fr)

# --- Base de données PostgreSQL ---
POSTGRES_DB=musicplatform
POSTGRES_USER=musicplatform
POSTGRES_PASSWORD=CHANGEME_strong_postgres_password_production
POSTGRES_PORT=55433

# --- Redis ---
REDIS_PORT=56380

# --- Authentification & Jetons JWT ---
JWT_SECRET=CHANGEME_must_be_at_least_32_characters_long_secret_key_prod
JWT_ISSUER=https://music.julien-sabourin.fr
JWT_AUDIENCE=https://music.julien-sabourin.fr
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Configuration Serveur & Domaines ---
ASPNETCORE_ENVIRONMENT=Production
WEB_PORT=8088
API_PORT=5081

# Origine autorisée par CORS (Domaine HTTPS de production)
WEB_ORIGIN=https://music.julien-sabourin.fr

# Désactiver Swagger et la télémétrie publique pour la sécurité
SWAGGER_ENABLED=false
OTLP_ENDPOINT=

# --- Compte Administrateur Initial ---
SEED_ADMIN_EMAIL=admin@julien-sabourin.fr
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGEME_AdminPass123!
