# Copiez ce fichier vers `.env` puis remplacez chaque valeur.
# `.env` contient des secrets : il est ignoré par Git et ne doit jamais être versionné.

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=musicplatform
POSTGRES_USER=musicplatform
# Obligatoire. Générez une valeur robuste : openssl rand -base64 24
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-genere
# Port publié sur la machine hôte (127.0.0.1 uniquement).
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
# Redis n'est qu'un cache : l'application reste fonctionnelle sans lui.
REDIS_PORT=6379

# --- Authentification --------------------------------------------------------
# Obligatoire, 32 caractères minimum. Générez : openssl rand -base64 48
JWT_SECRET=remplacez-par-une-cle-de-signature-de-32-caracteres-minimum
JWT_ISSUER=musicplatform
JWT_AUDIENCE=musicplatform
# Durée de vie de l'access token, en secondes.
JWT_ACCESS_TOKEN_LIFETIME=900
# Durée de vie du refresh token, en jours.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Application -------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Port du site web exposé publiquement.
WEB_PORT=8080
# Port de l'API, publié sur 127.0.0.1 seulement.
API_PORT=5080
# Origine autorisée par CORS. En production, l'URL publique du site.
WEB_ORIGIN=http://localhost:8080
# Expose /swagger. À laisser à false en production.
SWAGGER_ENABLED=false

# --- Import depuis un lien YouTube -------------------------------------------
# yt-dlp et ffmpeg sont installés dans l'image de l'API : rien à faire pour activer
# la fonctionnalité. Ces réglages ne servent qu'à l'ajuster.
# Débit de l'encodage MP3. À 128K, une vidéo de 15 minutes reste sous la limite de 20 Mo.
YTDLP_AUDIO_QUALITY=128K
# Durée maximale d'une vidéo importable, en secondes.
YTDLP_MAX_DURATION_SECONDS=900
# Délai au-delà duquel le téléchargement est abandonné, en secondes.
YTDLP_TIMEOUT_SECONDS=300

# --- Contournement du blocage YouTube ----------------------------------------
# YouTube bloque les adresses IP des hébergeurs. Un fichier de cookies issu d'un compte
# connecté lève ce blocage : placez-le à la racine du projet sous le nom cookies.txt
# (docker-compose le monte sur /app/cookies.txt).
#
# Export du fichier, dans cet ordre exact — sinon YouTube invalide la session :
#   1. ouvrir une fenêtre de navigation privée ;
#   2. se connecter à youtube.com (utilisez un compte secondaire, jamais le principal) ;
#   3. exporter les cookies au format Netscape avec une extension telle que
#      « Get cookies.txt LOCALLY », en filtrant sur le domaine youtube.com ;
#   4. fermer la fenêtre privée SANS se déconnecter : une déconnexion révoque les cookies.
# Les cookies expirent au bout de quelques semaines : refaites l'export si l'import
# échoue avec « cookies have expired » dans les journaux du conteneur.
YTDLP_COOKIES_FILE=/app/cookies.txt
# Clients YouTube essayés l'un après l'autre tant que l'authentification est refusée.
# « tv » accepte les cookies sans jeton anti-robot et réussit le plus souvent.
YTDLP_PLAYER_CLIENTS=tv,web_safari,web
# Force les sorties en IPv4 : les plages IPv6 des hébergeurs sont bloquées bien plus
# largement. Ne passez à false que si le serveur n'a pas de connectivité IPv4.
YTDLP_FORCE_IPV4=true
# Pause entre deux requêtes vers YouTube, en secondes. Augmentez-la si le blocage revient.
YTDLP_SLEEP_REQUESTS_SECONDS=1
# Proxy emprunté pour joindre YouTube (http://hôte:port ou socks5://hôte:port). Dernier
# recours si l'adresse du serveur reste bloquée malgré des cookies valides.
YTDLP_PROXY_URL=

# --- Observabilité (facultatif) ----------------------------------------------
# Point de collecte OTLP. Laissez vide pour désactiver l'export des traces et métriques.
OTLP_ENDPOINT=

# --- Compte administrateur initial (facultatif) ------------------------------
# Renseignez les trois valeurs pour créer un administrateur au premier démarrage.
# Laissez vide pour ne créer aucun compte : rien n'est codé en dur dans le code.
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
