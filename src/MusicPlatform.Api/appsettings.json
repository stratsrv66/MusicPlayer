{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "musicplatform",
    "Audience": "musicplatform",
    "AccessTokenLifetimeSeconds": 900,
    "RefreshTokenLifetimeDays": 30
  },
  "Storage": {
    "RootPath": "/data/storage"
  },
