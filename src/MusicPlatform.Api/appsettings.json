    "MetadataTimeoutSeconds": 120,
    "SearchResults": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Seed": {
    "Admin": {
      "Email": "",
      "Username": "",
      "Password": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
